<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- RS2008: release tracking does not apply to test-only probe diagnostics. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic testing packages without a framework suffix — the suffixed variants are obsolete. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="$(CodeAnalysisTestingVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="$(CodeAnalysisTestingVersion)" />
    <!-- Pin the Roslyn assemblies the test host loads; the testing package floor is far older. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityPerformanceAnalyzers\UnityPerformanceAnalyzers.csproj" />
    <ProjectReference Include="..\UnityPerformanceAnalyzers.CodeFixes\UnityPerformanceAnalyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\UnityPerformanceAnalyzers.RuleManifest\UnityPerformanceAnalyzers.RuleManifest.csproj" />
    <ProjectReference Include="..\UnityPerformanceAnalyzers.Cli\UnityPerformanceAnalyzers.Cli.csproj" />
    <ProjectReference Include="..\UnityStubs\UnityStubs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberate violations: read as text by the differential tests, never compiled. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
