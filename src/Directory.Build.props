<Project>

  <!-- Single source of truth for the version. The release workflow syncs
       package/package.json from here; never edit that version by hand. -->
  <PropertyGroup>
    <Version>0.10.0</Version>
    <Authors>NeshGames</Authors>
    <Company>NeshGames</Company>
    <Copyright>Copyright (c) 2026 NeshGames</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NeshGames/unity-performance-analyzers</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Unity 6 is the minimum supported editor. Its analyzer/source-generator compatibility
       guidance allows Microsoft.CodeAnalysis.CSharp 4.3, so 4.3.1 is the dependency floor.
       The load smoke also exercises the newer 4.10 compiler used by the current Unity 6
       sandbox. Do not raise this just because NuGet offers one: a newer analyzer dependency
       than the host compiler produces CS8032 and silently disables the analyzer. -->
  <PropertyGroup>
    <RoslynVersion>4.3.1</RoslynVersion>
    <RoslynAnalyzersVersion>3.3.4</RoslynAnalyzersVersion>
    <CodeAnalysisTestingVersion>1.1.2</CodeAnalysisTestingVersion>
  </PropertyGroup>

</Project>
