# unity-performance-analyzers preset: strict (IDE parity variant)
# Unity itself does not read .editorconfig (verified 2022.3/6000.5) - use the
# .ruleset of the same name for Unity builds. This file keeps Rider/VS in sync
# and carries the IDE-only hot-path options.
# GENERATED FILE - do not edit. Severities live in PresetTable.cs;
# regenerate via the RuleManifest presets mode (see that file's header).
root = true

[*.cs]
dotnet_diagnostic.UPA0001.severity = error
dotnet_diagnostic.UPA0002.severity = error
