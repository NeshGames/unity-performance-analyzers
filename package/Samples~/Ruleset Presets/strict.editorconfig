# Hot-path classification (IDE only; Unity builds use the built-in defaults)
# upa_hot_path_messages = Update,FixedUpdate,LateUpdate
# upa_hot_path_attributes = HotPath,PerformanceCritical
# upa_hot_path_include_lambdas = true

# Rule options
# upa_enum_switch_allow_default = true
# upa_addrange_hot_path_only = false

# Editor tooling: relax performance pressure (IDE side; for Unity builds place
# editor-relaxed.ruleset as Default.ruleset in your Editor asmdef folders)
[**/Editor/**/*.cs]
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion
dotnet_diagnostic.UPA0005.severity = none
