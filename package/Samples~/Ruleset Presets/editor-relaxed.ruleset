<?xml version="1.0" encoding="utf-8"?>
<!-- unity-performance-analyzers: relaxed ruleset for Editor tooling assemblies.
     Rulesets have no path scoping, so editor code gets its own file instead:
     copy this into each Editor asmdef folder and rename it Default.ruleset -
     it then overrides the project-wide Assets/Default.ruleset for that assembly.

     Performance pressure is irrelevant in editor tooling, so UPA performance
     and ecosystem rules are off; UNT correctness rules stay at Error. Rules
     about how a type is declared keep their severity - being in editor code
     does not make a struct any better as a dictionary key.
     GENERATED FILE - do not edit. Severities live in PresetTable.cs;
     regenerate via the RuleManifest presets mode (see that file's header). -->
<RuleSet Name="UPA editor-relaxed" ToolsVersion="10.0">
  <Rules AnalyzerId="UnityPerformanceAnalyzers" RuleNamespace="UnityPerformanceAnalyzers">
    <Rule Id="UPA0001" Action="None" />
    <Rule Id="UPA0002" Action="None" />
    <Rule Id="UPA0003" Action="None" />
    <Rule Id="UPA0004" Action="None" />
    <Rule Id="UPA0005" Action="None" />
    <Rule Id="UPA0006" Action="None" />
    <Rule Id="UPA0007" Action="None" />
    <Rule Id="UPA0008" Action="None" />
