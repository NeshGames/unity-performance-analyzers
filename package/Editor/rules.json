  "options": [
    {
      "key": "upa_hot_path_messages",
      "type": "list",
      "default": "Update,FixedUpdate,LateUpdate,OnGUI,OnAnimatorMove,OnAnimatorIK,OnPreCull,OnPreRender,OnPostRender,OnRenderObject,OnWillRenderObject,OnRenderImage,OnTriggerStay,OnTriggerStay2D,OnCollisionStay,OnCollisionStay2D,OnParticleUpdateJobScheduled",
      "description": "Unity messages treated as per-frame hot paths. Replaces the default set."
    },
    {
      "key": "upa_hot_path_attributes",
      "type": "list",
      "default": "HotPath,PerformanceCritical",
      "description": "Attribute short names that mark any method as a hot path ('Attribute' suffix optional)."
    },
    {
      "key": "upa_hot_path_include_lambdas",
      "type": "bool",
      "default": "true",
      "description": "Treat lambdas and local functions declared inside a hot-path method as hot."
    },
    {
      "key": "upa_enum_switch_allow_default",
      "type": "bool",
      "default": "true",
      "description": "For UPA1001, a default branch (or discard arm) counts as exhaustive."
    }
  ]
