# .NET
bin/
obj/
artifacts/
TestResults/
*.user
.vs/
.idea/

# Analyzer DLL is placed into the package by the release workflow (git add -f)
package/Analyzers/*.dll

# Unity sandbox project (generated state)
sandbox/UnityProject/[Ll]ibrary/
sandbox/UnityProject/[Tt]emp/
sandbox/UnityProject/[Oo]bj/
sandbox/UnityProject/[Ll]ogs/
sandbox/UnityProject/[Uu]serSettings/
sandbox/UnityProject/ProjectSettings/*
# Written per run by sandbox/verify.sh, from manifest.template.json and the version being
# verified. Committing either one means the first editor to open the project upgrades it,
# and the older editor can then no longer resolve its packages.
sandbox/UnityProject/Packages/manifest.json
sandbox/UnityProject/Packages/packages-lock.json
sandbox/*.log
sandbox/verify-*.txt
# Player builds from the allocation measurement harness. The reports under
# sandbox/UnityProject/Measurements/ are the durable artifact; the players are not.
sandbox/UnityProject/Builds/

# Unity load smoke probe project. Everything in it is generated by
# .github/smoke/unity-load.sh on each run - the probe sources are copied in from
# .github/smoke/, and Unity writes the rest. Only the manifest template is tracked.
.github/smoke/UnityProbe/*
!.github/smoke/UnityProbe/Packages/
.github/smoke/UnityProbe/Packages/*
!.github/smoke/UnityProbe/Packages/manifest.template.json
